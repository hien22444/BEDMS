############################
# Server
############################
PORT=3001
NODE_ENV=development

# Comma-separated list for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

############################
# Database
############################
# MONGODB_URI=mongodb://...

############################
# PayOS (REAL MONEY) - DO NOT COMMIT REAL KEYS
############################
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# FE redirect URLs after user finishes/cancels payment on PayOS UI
# Example:
# PAYOS_RETURN_URL=http://localhost:5173/student/booking?payment=success
# PAYOS_CANCEL_URL=http://localhost:5173/student/booking?payment=cancel
PAYOS_RETURN_URL=
PAYOS_CANCEL_URL=

############################
# Email (SMTP) - for payment success notification
############################
# Example for Gmail SMTP:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM="FPT Dormitory <your_email@gmail.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

