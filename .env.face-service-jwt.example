FACE_SERVICE_JWT_ISSUER=https://bedms-production.up.railway.app
FACE_SERVICE_JWT_AUDIENCE=faceservice
FACE_SERVICE_JWT_KEY_ID=bedms-face-service-key-1
FACE_SERVICE_JWT_TTL_SECONDS=300

# PEM values can be stored as literal multiline text or with \n escapes.
FACE_SERVICE_JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nreplace-with-private-key\n-----END RSA PRIVATE KEY-----"
FACE_SERVICE_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nreplace-with-public-key\n-----END PUBLIC KEY-----"
